---
// The homepage, for people. Agents have their own front door: the Worker answers `/` with /llms.txt when a request
// does not ask for HTML, and the docs carry the detail.
//
// The pitch: one tool for the whole data pipeline, all in TypeScript. The tools it replaces are named once, in the
// comparison table, and as "replaces", never "compatible with": croft reads no dbt project or dlt pipeline. The code
// samples are the Quickstart's (docs/quickstart.md), cut down.
import version from '../generated-version.json'
import mark from '../assets/mark.svg?raw'

const title = 'croft: the whole data pipeline, in TypeScript'
const description =
  'One tool for the whole data pipeline, in TypeScript: pull data from APIs and files, transform it, and keep it fresh on a schedule. One CLI, one DuckDB file.'
const canonical = new URL('/', Astro.site).href
// public/og.png, rendered from src/assets/og.svg. The docs pages name the same card (astro.config.mjs).
const ogImage = new URL('/og.png', Astro.site).href

// Braces in a template's text start an expression, so the code samples are strings.
const ingestCode = `<span class="cm">// assets/stripe_charges.ts</span>
export default ingest({
  key: <span class="s">"id"</span>,
  schedule: <span class="s">"every hour"</span>,
  async *rows({ http }) { … },
});`
const appCode = `<span class="kw">import</span> { query } <span class="kw">from</span> <span class="s">"@zabaca/croft/read"</span>;

<span class="kw">const</span> rows = <span class="kw">await</span> query(
  <span class="s">"from revenue_by_month order by month"</span>,
);`
const typeCode = `<span class="cm">// .croft/types/revenue_by_region.d.ts, written by croft</span>
<span class="kw">export type</span> RevenueByRegionRow = {
  region: string;            <span class="cm">// VARCHAR, the key</span>
  orders: number | bigint | null;
  revenue: number | null;    <span class="cm">// DOUBLE</span>
};`
const typeError = `<span class="p">$</span> croft validate --types
<span class="err">error UNKNOWN_INPUT_COLUMN</span>  assets/region_labels.ts:9:65
      revenue_by_region has no column "revenue"
      <span class="k">fix:</span> revenue_by_region has these columns:
           region, orders, total, _loaded_at`
const sqlCode = `<span class="cm">-- assets/revenue_by_month.sql</span>
<span class="cm">-- check: revenue >= 0</span>
SELECT month,
       sum(amount) AS revenue
FROM stripe_charges
GROUP BY month`
const runCode = `<span class="p">$</span> croft schedule on
<span class="p">$</span> croft status
ASSET              NEXT
stripe_charges     every hour
revenue_by_month   after inputs`
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="croft docs, for agents" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="croft" />
    <meta property="og:locale" content="en" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline src="/analytics.js" defer></script>
    <script is:inline>
      // Follow the theme chosen in the docs (Starlight stores it as starlight-theme), else the system's.
      try {
        const t = localStorage.getItem('starlight-theme')
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t
      } catch {}
    </script>
    <style is:global>
      :root {
        --ground: #f7f4ec;
        --raised: #fffdf8;
        --sunk: #eee9dc;
        --ink: #1b1a16;
        --ink-2: #4c483e;
        --ink-3: #7c7668;
        --rule: #e0d9c9;
        --green: #2f6b3e;
        --green-2: #3d8550;
        --ochre: #b0701e;
        --sans: ui-sans-serif, -apple-system, 'Segoe UI', Inter, Roboto, 'Helvetica Neue', Arial, sans-serif;
        --mono: ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace;
        color-scheme: light;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          --ground: #141411;
          --raised: #1c1b17;
          --sunk: #24231e;
          --ink: #f1ede2;
          --ink-2: #c4beaf;
          --ink-3: #8f8979;
          --rule: #2f2d27;
          --green: #7cc28c;
          --green-2: #95d4a3;
          --ochre: #e0a24a;
          color-scheme: dark;
        }
      }
      :root[data-theme='dark'] {
        --ground: #141411;
        --raised: #1c1b17;
        --sunk: #24231e;
        --ink: #f1ede2;
        --ink-2: #c4beaf;
        --ink-3: #8f8979;
        --rule: #2f2d27;
        --green: #7cc28c;
        --green-2: #95d4a3;
        --ochre: #e0a24a;
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body { margin: 0; background: var(--ground); color: var(--ink); font: 17px/1.65 var(--sans); }
      a { color: var(--green); text-underline-offset: 3px; }
      code, pre { font-family: var(--mono); }
      .wrap { max-width: 62rem; margin: 0 auto; padding-inline: 1.25rem; }
    </style>
    <style>
      header .wrap { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 1.1rem; }
      .brand { display: flex; align-items: center; gap: 0.55rem; color: var(--ink); text-decoration: none; font-weight: 650; font-size: 1.15rem; }
      .brand :global(svg) { width: 1.6rem; height: 1.6rem; display: block; }
      nav { display: flex; gap: 1.4rem; font-size: 0.97rem; }
      nav a { color: var(--ink-2); text-decoration: none; }
      nav a:hover { color: var(--ink); }

      .hero { text-align: center; padding-block: 5rem 4.5rem; }
      h1 { font-size: clamp(2.3rem, 5.5vw, 3.8rem); line-height: 1.05; letter-spacing: -0.035em; margin: 0 auto 1.3rem; max-width: 22ch; font-weight: 720; text-wrap: balance; }
      h1 em { font-style: normal; color: var(--green); }
      .lede { font-size: clamp(1.1rem, 2vw, 1.25rem); color: var(--ink-2); margin: 0 auto 2.2rem; max-width: 36rem; text-wrap: balance; }
      .ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }
      .btn { display: inline-flex; align-items: center; padding: 0.8rem 1.3rem; border-radius: 10px; font-weight: 600; text-decoration: none; }
      .btn.primary { background: var(--green); color: var(--ground); }
      .btn.primary:hover { background: var(--green-2); }
      .btn.ghost { color: var(--ink); border: 1px solid var(--rule); }
      .btn.ghost:hover { border-color: var(--ink-3); }
      .fine { margin-top: 1.1rem; font-size: 0.9rem; color: var(--ink-3); }
      .demo { margin: 3rem auto 0; max-width: 56rem; border-radius: 16px; overflow: hidden; border: 1px solid var(--rule); background: var(--sunk); box-shadow: 0 24px 60px -30px rgb(27 26 22 / 0.35); }
      .demo video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; }

      section { padding-block: 4.5rem; border-top: 1px solid var(--rule); }
      h2 { font-size: clamp(1.6rem, 3.4vw, 2.2rem); letter-spacing: -0.025em; line-height: 1.15; margin: 0 0 0.75rem; font-weight: 700; }
      .intro { color: var(--ink-2); max-width: 38rem; margin: 0 0 2.5rem; font-size: 1.08rem; }


      .two { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3rem; }
      .points { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; }
      .points li { padding-left: 1.6rem; position: relative; color: var(--ink-2); }
      .points li::before { content: '✓'; position: absolute; left: 0; color: var(--green); font-weight: 700; }
      .points strong { color: var(--ink); }

      .chat { background: var(--raised); border: 1px solid var(--rule); border-radius: 14px; padding: 1.4rem 1.5rem; display: grid; gap: 1rem; align-self: start; }
      .msg { font-size: 0.97rem; }
      .msg b { display: block; font-size: 0.78rem; letter-spacing: 0.05em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 0.2rem; }
      .msg.you { color: var(--ink); }
      .msg.claude { color: var(--ink-2); }
      .msg.ask { border-left: 3px solid var(--ochre); padding-left: 0.9rem; }

      .facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
      .facts div { padding: 1.3rem 0 0; border-top: 2px solid var(--green); }
      .facts h3 { margin: 0 0 0.35rem; font-size: 1.05rem; }
      .facts p { margin: 0; color: var(--ink-2); font-size: 0.97rem; }

      .end { text-align: center; }
      .install { display: inline-flex; align-items: center; gap: 0.75rem; max-width: 100%; background: var(--raised); border: 1px solid var(--rule); border-radius: 10px; padding: 0.65rem 0.65rem 0.65rem 1rem; margin: 0.5rem 0 1.5rem; }
      .install code { min-width: 0; overflow-x: auto; white-space: nowrap; font-size: 0.95rem; }
      .install code::before { content: '$ '; color: var(--ink-3); }
      .copy { font: 600 0.8rem/1 var(--sans); border: 1px solid var(--rule); background: var(--ground); color: var(--ink-2); border-radius: 7px; padding: 0.5rem 0.7rem; cursor: pointer; }
      .copy:hover { color: var(--ink); }

      footer { border-top: 1px solid var(--rule); padding-block: 1.75rem 2.5rem; color: var(--ink-3); font-size: 0.9rem; }
      footer .wrap { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; justify-content: space-between; }
      footer a { color: var(--ink-2); }
      footer span:last-child { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; }

      @media (max-width: 820px) {
        .facts, .two { grid-template-columns: minmax(0, 1fr); }
        .two { gap: 2rem; }
        .hero { padding-block: 3.5rem 3rem; }
        section { padding-block: 3.25rem; }
      }

      .eyebrow { display: inline-block; font: 600 0.8rem/1 var(--mono); color: var(--ochre); letter-spacing: 0.06em; text-transform: uppercase; margin: 0 0 1.2rem; }
      h1 .tools { white-space: nowrap; }

      .map { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
      .map li { background: var(--raised); border: 1px solid var(--rule); border-radius: 14px; padding: 1.4rem 1.5rem 1.5rem; display: flex; flex-direction: column; }
      .map .was { font: 600 0.78rem/1 var(--mono); color: var(--ochre); text-transform: uppercase; letter-spacing: 0.06em; display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.9rem; }
      .map h3 { margin: 0 0 0.4rem; font-size: 1.15rem; letter-spacing: -0.01em; }
      .map p { margin: 0 0 1.1rem; color: var(--ink-2); font-size: 0.98rem; }
      .map pre { margin: auto 0 0; background: var(--sunk); border-radius: 9px; padding: 0.85rem 1rem; font-size: 0.78rem; line-height: 1.6; overflow-x: auto; color: var(--ink); }
      .map pre :global(.cm) { color: var(--ink-3); }
      .map pre :global(.s) { color: var(--green); }
      .map pre :global(.p) { color: var(--ink-3); }
      .map pre :global(.kw) { color: var(--ochre); }

      .cmp-wrap { overflow-x: auto; border: 1px solid var(--rule); border-radius: 14px; background: var(--raised); }
      .cmp { width: 100%; border-collapse: collapse; font-size: 0.97rem; min-width: 34rem; }
      .cmp th, .cmp td { text-align: left; padding: 0.85rem 1.1rem; border-bottom: 1px solid var(--rule); vertical-align: top; }
      .cmp tbody tr:last-child th, .cmp tbody tr:last-child td { border-bottom: 0; }
      .cmp thead th { font: 600 0.78rem/1.2 var(--mono); text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-3); }
      .cmp tbody th { font-weight: 600; color: var(--ink); width: 28%; }
      .cmp td { color: var(--ink-2); }
      .cmp .us { color: var(--ink); background: color-mix(in srgb, var(--green) 9%, transparent); }
      .cmp thead .us { color: var(--green); }
      .cmp code { font-size: 0.86em; background: var(--sunk); padding: 0.1em 0.35em; border-radius: 4px; }

      .honest { margin: 1.5rem 0 0; color: var(--ink-3); font-size: 0.93rem; max-width: 44rem; }

      .typed { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 3rem; align-items: start; }
      .typed-code pre { margin: 0; background: var(--raised); border: 1px solid var(--rule); border-radius: 12px; padding: 1rem 1.1rem; font-size: 0.78rem; line-height: 1.6; overflow-x: auto; color: var(--ink); }
      .typed-code pre :global(.cm), .typed-code pre :global(.p) { color: var(--ink-3); }
      .typed-code pre :global(.kw) { color: var(--ochre); }
      .typed-code pre :global(.err) { color: #d9604c; font-weight: 600; }
      .typed-code pre :global(.k) { color: var(--green); }
      .caption { margin: 1rem 0 0.5rem; font-size: 0.9rem; color: var(--ink-3); }
      .caption code { font-size: 0.9em; }
      .agent { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 3rem; align-items: start; }

      @media (max-width: 820px) {
        .map, .agent, .typed { grid-template-columns: minmax(0, 1fr); }
        h1 .tools { white-space: normal; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="wrap">
        <a class="brand" href="/"><Fragment set:html={mark} />croft</a>
        <nav aria-label="Main">
          <a href="/docs/">Docs</a>
          <a href="https://github.com/Zabaca/croft">GitHub</a>
        </nav>
      </div>
    </header>

    <main>
      <div class="wrap hero">
        <p class="eyebrow">Data pipelines for TypeScript</p>
        <h1>The whole data pipeline, <em>in TypeScript.</em></h1>
        <p class="lede">Pull data in, transform it, keep it fresh. One CLI, one DuckDB file.</p>
        <div class="ctas">
          <a class="btn primary" href="/docs/quickstart/">Get started</a>
          <a class="btn ghost" href="/docs/concepts/">How it works</a>
        </div>
        <p class="fine">Free and open source · macOS and Linux</p>
        <!-- The launch video (docs/launch/product-hunt/video/), a real croft 0.3.0 session in one minute. Captions
             are in the picture, so it reads muted. preload="none": the 3.5 MB loads only when someone presses play. -->
        <div class="demo">
          <video controls playsinline preload="none" poster="/croft-demo-poster.jpg" width="1920" height="1080">
            <source src="/croft-demo.mp4" type="video/mp4" />
          </video>
        </div>
      </div>

      <section>
        <div class="wrap">
          <h2>One tool, end to end</h2>
          <p class="intro">A croft project is a folder of TypeScript and SQL files. Each file becomes one table, and croft runs them in order.</p>
          <ol class="map">
            <li>
              <div class="was">Ingest</div>
              <h3>Bring data in</h3>
              <p>From Stripe, GitHub or any API, or from CSV exports. Incremental, typed, and safe to rerun.</p>
              <pre set:html={ingestCode} />
            </li>
            <li>
              <div class="was">Transform</div>
              <h3>Shape it</h3>
              <p>A SQL query or a TypeScript function per table, with checks that run before anything is saved.</p>
              <pre set:html={sqlCode} />
            </li>
            <li>
              <div class="was">Schedule</div>
              <h3>Keep it fresh</h3>
              <p>A schedule in plain words. Everything downstream updates after it, in order.</p>
              <pre set:html={runCode} />
            </li>
            <li>
              <div class="was">Serve</div>
              <h3>Use it in your app</h3>
              <p>Query the tables from any Bun or Node app, with no database server to run.</p>
              <pre set:html={appCode} />
            </li>
          </ol>
        </div>
      </section>

      <section>
        <div class="wrap typed">
          <div>
            <h2>Typed across SQL and TypeScript</h2>
            <p class="intro">Every table gets a TypeScript type, generated from its real columns. Change a SQL query, and croft checks the TypeScript that reads it, before anything runs.</p>
            <ul class="points">
              <li><strong>Rename a column, see what breaks.</strong> Code that reads the old name fails the check, with the columns it could read instead.</li>
              <li><strong>Mistyped SQL is caught early.</strong> Every query is checked against the columns it reads, without running it.</li>
              <li><strong>Typed in your app too.</strong> <code>query&lt;"revenue_by_month"&gt;()</code> returns that table's columns, and a renamed one breaks your app's type-check.</li>
              <li><strong>Autocomplete for your data.</strong> Your editor knows each table's columns and their types.</li>
            </ul>
          </div>
          <div class="typed-code">
            <pre set:html={typeCode} />
            <p class="caption">After renaming <code>revenue</code> to <code>total</code> in the SQL:</p>
            <pre set:html={typeError} />
          </div>
        </div>
      </section>

      <section>
        <div class="wrap">
          <h2>What it replaces</h2>
          <p class="intro">A typical data stack is several tools, in Python and YAML, glued together. croft is one, in TypeScript.</p>
          <div class="cmp-wrap">
            <table class="cmp">
              <thead>
                <tr><th scope="col">Job</th><th scope="col">The usual stack</th><th scope="col" class="us">croft</th></tr>
              </thead>
              <tbody>
                <tr><th scope="row">Load from APIs and files</th><td>dlt, Airbyte or custom Python scripts</td><td class="us"><code>ingest()</code> in a <code>.ts</code> file</td></tr>
                <tr><th scope="row">Transform</th><td>dbt models (SQL and YAML)</td><td class="us">a <code>.sql</code> file, or <code>transform()</code> in TypeScript</td></tr>
                <tr><th scope="row">Test the data</th><td>dbt tests</td><td class="us">checks that run before every save</td></tr>
                <tr><th scope="row">Schedule and orchestrate</th><td>Dagster, Airflow or cron</td><td class="us"><code>schedule: "every hour"</code></td></tr>
                <tr><th scope="row">Catch a broken column</th><td>when the warehouse runs the model</td><td class="us">before anything runs, from SQL into the TypeScript that reads it</td></tr>
                <tr><th scope="row">Store</th><td>a warehouse to host and pay for</td><td class="us">one DuckDB file on your machine</td></tr>
                <tr><th scope="row">Read from your app</th><td>a client and credentials per warehouse</td><td class="us"><code>@zabaca/croft/read</code>, typed by table</td></tr>
                <tr><th scope="row">Language</th><td>Python, YAML and SQL</td><td class="us">TypeScript, and SQL where you want it</td></tr>
              </tbody>
            </table>
          </div>
          <p class="honest">
            croft does these jobs; it does not read those tools' projects. It is built for one machine and one DuckDB
            file. If your team already runs a warehouse with dbt, keep it.
          </p>
        </div>
      </section>

      <section>
        <div class="wrap agent">
          <div>
            <h2>And your agent can run it</h2>
            <p class="intro">Tell Claude Code what you want. It writes the pipeline, and croft checks every step.</p>
            <ul class="points">
              <li><strong>Mistakes are caught early.</strong> croft checks each change before it runs, and tells the agent exactly what to fix.</li>
              <li><strong>Try before it's real.</strong> Every change can be previewed first, without touching your tables.</li>
              <li><strong>You stay in charge.</strong> Anything that could lose data stops and waits for your OK.</li>
            </ul>
          </div>
          <div class="chat" aria-label="An example conversation">
            <div class="msg"><b>An example</b></div>
            <div class="msg you"><b>You</b>Pull my Stripe charges in every hour and show me revenue by month.</div>
            <div class="msg claude"><b>Claude</b>Done. stripe_charges loads every hour, and revenue_by_month is built from it. I previewed both first: 1,204 charges, 14 months.</div>
            <div class="msg claude ask"><b>Claude</b>Turning on the hourly schedule runs it without me. Shall I?</div>
          </div>
        </div>
      </section>

      <section>
        <div class="wrap">
          <h2>Your data stays safe</h2>
          <p class="intro">Some data can't be fetched again. croft never throws it away on its own.</p>
          <div class="facts">
            <div><h3>Nothing half-saved</h3><p>Each update is saved whole or not at all, and a failed check keeps the old data.</p></div>
            <div><h3>A trash you can undo</h3><p>Anything replaced or deleted goes to the trash first, and comes back with one command.</p></div>
            <div><h3>On your machine</h3><p>One file on your computer. No account, no server, no cloud to pay for.</p></div>
          </div>
        </div>
      </section>

      <section class="end">
        <div class="wrap">
          <h2>Try it in five minutes</h2>
          <p class="intro" style="margin-inline: auto">Install it, then follow the Quickstart.</p>
          <div class="install">
            <code id="install">bun add -g @zabaca/croft</code>
            <button class="copy" type="button" data-copy="install">Copy</button>
          </div>
          <div class="ctas">
            <a class="btn primary" href="/docs/quickstart/">Open the Quickstart</a>
          </div>
          <p class="fine">Needs <a href="https://bun.sh">Bun</a>.</p>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap">
        <span>croft {version.version} · MIT · by <a href="https://zabaca.com">Zabaca</a></span>
        <span>
          <a href="/docs/">Docs</a>
          <a href="https://github.com/Zabaca/croft">GitHub</a>
          <a href="https://www.npmjs.com/package/@zabaca/croft">npm</a>
          <a href="/llms.txt">For AI agents</a>
        </span>
      </div>
    </footer>

    <script>
      for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
        button.addEventListener('click', async () => {
          const text = document.getElementById(button.dataset.copy!)?.textContent ?? ''
          try {
            await navigator.clipboard.writeText(text)
            button.textContent = 'Copied'
          } catch {
            button.textContent = 'Select it'
          }
          setTimeout(() => (button.textContent = 'Copy'), 1600)
        })
      }
    </script>
  </body>
</html>
