{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "croft query --json",
  "description": "The envelope croft query --json prints on stdout (DESIGN.md §4.3). data is null when the command failed before it had any.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "command": {
      "const": "query"
    },
    "croftVersion": {
      "type": "string"
    },
    "database": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "durationMs": {
      "type": "number"
    },
    "data": {
      "anyOf": [
        {
          "title": "QueryData",
          "type": "object",
          "properties": {
            "columns": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ColumnInfo"
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Row"
              }
            },
            "rowCount": {
              "type": "number"
            },
            "truncatedRows": {
              "type": "number"
            },
            "truncatedValues": {
              "type": "number"
            },
            "redactedValues": {
              "const": true
            }
          },
          "required": [
            "columns",
            "rows",
            "rowCount",
            "truncatedRows",
            "truncatedValues"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "problems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Problem"
      }
    },
    "next": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "command",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "confirmation": {
      "$ref": "#/$defs/Confirmation"
    }
  },
  "required": [
    "schemaVersion",
    "ok",
    "command",
    "croftVersion",
    "database",
    "timezone",
    "durationMs",
    "data",
    "problems",
    "next"
  ],
  "additionalProperties": false,
  "$defs": {
    "ColumnInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false
    },
    "Confirmation": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "impact": {
          "$ref": "#/$defs/Impact"
        }
      },
      "required": [
        "token",
        "expiresAt",
        "command",
        "impact"
      ],
      "additionalProperties": false
    },
    "Fix": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "command"
            },
            "description": {
              "type": "string"
            },
            "command": {
              "type": "string"
            },
            "requiresHuman": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "description",
            "command"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "edit"
            },
            "description": {
              "type": "string"
            },
            "file": {
              "type": "string"
            },
            "line": {
              "type": "number"
            },
            "replace": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                }
              },
              "required": [
                "from",
                "to"
              ],
              "additionalProperties": false
            },
            "insert": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "description",
            "file"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "manual"
            },
            "description": {
              "type": "string"
            },
            "requiresHuman": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "description"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Impact": {
      "type": "object",
      "properties": {
        "asset": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "rows": {
          "type": "number"
        },
        "bytes": {
          "type": "number"
        },
        "trashPath": {
          "type": "string"
        },
        "downstream": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "estimatedRequests": {
          "type": "number"
        }
      },
      "required": [
        "asset",
        "action",
        "rows",
        "downstream"
      ],
      "additionalProperties": false
    },
    "Problem": {
      "type": "object",
      "properties": {
        "severity": {
          "enum": [
            "error",
            "info",
            "warning"
          ]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "docs": {
          "type": "string"
        },
        "asset": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "number"
        },
        "column": {
          "type": "number"
        },
        "runId": {
          "type": "string"
        },
        "fix": {
          "$ref": "#/$defs/Fix"
        },
        "effect": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "severity",
        "code",
        "message",
        "hint",
        "docs"
      ],
      "additionalProperties": false
    },
    "Row": {
      "type": "object"
    }
  }
}
