{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "croft logs --json",
  "description": "The envelope croft logs --json prints on stdout (DESIGN.md §4.3). data is null when the command failed before it had any.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "command": {
      "const": "logs"
    },
    "croftVersion": {
      "type": "string"
    },
    "database": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "durationMs": {
      "type": "number"
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "logs"
            },
            "target": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "asset",
                    "latest",
                    "run"
                  ]
                },
                "value": {
                  "type": [
                    "null",
                    "string"
                  ]
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            "steps": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/StepLog"
              }
            },
            "followed": {
              "type": "boolean"
            },
            "redactedValues": {
              "const": true
            }
          },
          "required": [
            "mode",
            "target",
            "steps",
            "followed"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "runs"
            },
            "target": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "asset",
                    "latest",
                    "run"
                  ]
                },
                "value": {
                  "type": [
                    "null",
                    "string"
                  ]
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            "runs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/RunEntry"
              }
            },
            "limit": {
              "type": "number"
            },
            "redactedValues": {
              "const": true
            }
          },
          "required": [
            "mode",
            "target",
            "runs",
            "limit"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "problems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Problem"
      }
    },
    "next": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "command",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "confirmation": {
      "$ref": "#/$defs/Confirmation"
    }
  },
  "required": [
    "schemaVersion",
    "ok",
    "command",
    "croftVersion",
    "database",
    "timezone",
    "durationMs",
    "data",
    "problems",
    "next"
  ],
  "additionalProperties": false,
  "$defs": {
    "Confirmation": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "impact": {
          "$ref": "#/$defs/Impact"
        }
      },
      "required": [
        "token",
        "expiresAt",
        "command",
        "impact"
      ],
      "additionalProperties": false
    },
    "Fix": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "command"
            },
            "description": {
              "type": "string"
            },
            "command": {
              "type": "string"
            },
            "requiresHuman": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "description",
            "command"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "edit"
            },
            "description": {
              "type": "string"
            },
            "file": {
              "type": "string"
            },
            "line": {
              "type": "number"
            },
            "replace": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                }
              },
              "required": [
                "from",
                "to"
              ],
              "additionalProperties": false
            },
            "insert": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "description",
            "file"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "manual"
            },
            "description": {
              "type": "string"
            },
            "requiresHuman": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "description"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Impact": {
      "type": "object",
      "properties": {
        "asset": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "rows": {
          "type": "number"
        },
        "bytes": {
          "type": "number"
        },
        "trashPath": {
          "type": "string"
        },
        "downstream": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "estimatedRequests": {
          "type": "number"
        }
      },
      "required": [
        "asset",
        "action",
        "rows",
        "downstream"
      ],
      "additionalProperties": false
    },
    "Problem": {
      "type": "object",
      "properties": {
        "severity": {
          "enum": [
            "error",
            "info",
            "warning"
          ]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "docs": {
          "type": "string"
        },
        "asset": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "number"
        },
        "column": {
          "type": "number"
        },
        "runId": {
          "type": "string"
        },
        "fix": {
          "$ref": "#/$defs/Fix"
        },
        "effect": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "severity",
        "code",
        "message",
        "hint",
        "docs"
      ],
      "additionalProperties": false
    },
    "RunEntry": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        },
        "human": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        },
        "startedAt": {
          "type": "string"
        },
        "finishedAt": {
          "type": [
            "null",
            "string"
          ]
        },
        "durationMs": {
          "type": [
            "null",
            "number"
          ]
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "asset": {
                "type": "string"
              },
              "attempt": {
                "type": "number"
              },
              "status": {
                "type": "string"
              },
              "reason": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "startedAt": {
                "type": "string"
              },
              "finishedAt": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "durationMs": {
                "type": [
                  "null",
                  "number"
                ]
              },
              "rows": {
                "type": "object",
                "properties": {
                  "in": {
                    "type": [
                      "null",
                      "number"
                    ]
                  },
                  "added": {
                    "type": [
                      "null",
                      "number"
                    ]
                  },
                  "updated": {
                    "type": [
                      "null",
                      "number"
                    ]
                  }
                },
                "required": [
                  "in",
                  "added",
                  "updated"
                ],
                "additionalProperties": false
              },
              "error": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string"
                      },
                      "message": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "code",
                      "message"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "logsCommand": {
                "type": "string"
              }
            },
            "required": [
              "asset",
              "attempt",
              "status",
              "reason",
              "startedAt",
              "finishedAt",
              "durationMs",
              "rows",
              "error",
              "logsCommand"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "runId",
        "trigger",
        "human",
        "status",
        "startedAt",
        "finishedAt",
        "durationMs",
        "argv",
        "steps"
      ],
      "additionalProperties": false
    },
    "StepLog": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string"
        },
        "asset": {
          "type": "string"
        },
        "attempt": {
          "type": "number"
        },
        "status": {
          "type": "string"
        },
        "reason": {
          "type": [
            "null",
            "string"
          ]
        },
        "startedAt": {
          "type": "string"
        },
        "finishedAt": {
          "type": [
            "null",
            "string"
          ]
        },
        "log": {
          "type": [
            "null",
            "string"
          ]
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "truncated": {
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Problem"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "runId",
        "asset",
        "attempt",
        "status",
        "reason",
        "startedAt",
        "finishedAt",
        "log",
        "lines",
        "truncated",
        "error"
      ],
      "additionalProperties": false
    }
  }
}
