{
  "name": "@zabaca/croft",
  "version": "0.1.0-dev.0",
  "description": "Local-first data pipelines in TypeScript: ingest APIs and files, transform with SQL or TypeScript, keep DuckDB tables fresh.",
  "license": "MIT",
  "type": "module",
  "bin": { "croft": "bin/croft.mjs" },
  "exports": {
    ".": "./src/index.ts",
    "./read": { "types": "./dist/read.d.ts", "default": "./dist/read.js" }
  },
  "files": ["bin", "src", "dist", "schemas", "croft.schema.json", "!src/**/*.test.ts", "!src/**/testkit.ts", "!src/**/*-testkit.ts", "!src/**/fixtures"],
  "engines": { "bun": ">=1.3.14" },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "eval": "bun evals/run.ts",
    "build": "bun scripts/build-read.ts",
    "build:read": "bun scripts/build-read.ts",
    "build:schemas": "bun scripts/build-schemas.ts",
    "prepack": "bun scripts/build-read.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.5"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.2"
  }
}
