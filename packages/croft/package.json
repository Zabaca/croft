{
  "name": "@zabaca/croft",
  "version": "0.3.0",
  "description": "The whole data pipeline, in TypeScript: ingest APIs and files, transform with SQL or TypeScript, keep DuckDB tables fresh, and read them from your app.",
  "keywords": ["data-pipeline", "etl", "elt", "duckdb", "typescript", "bun", "ingest", "transform", "scheduler", "claude-code"],
  "homepage": "https://croft.zabaca.com",
  "repository": { "type": "git", "url": "git+https://github.com/Zabaca/croft.git", "directory": "packages/croft" },
  "bugs": { "url": "https://github.com/Zabaca/croft/issues" },
  "license": "MIT",
  "type": "module",
  "bin": { "croft": "bin/croft.mjs" },
  "exports": {
    ".": "./src/index.ts",
    "./read": { "types": "./dist/read.d.ts", "default": "./dist/read.js" }
  },
  "files": ["bin", "src", "dist", "schemas", "croft.schema.json", "!src/**/*.test.ts", "!src/**/testkit.ts", "!src/**/*-testkit.ts", "!src/**/fixtures"],
  "engines": { "bun": ">=1.3.14" },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "eval": "bun evals/run.ts",
    "build": "bun scripts/build-read.ts",
    "build:read": "bun scripts/build-read.ts",
    "build:schemas": "bun scripts/build-schemas.ts",
    "prepack": "bun scripts/build-read.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "2.0.0-r.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.2"
  }
}
